# =============================================================================
# DocuMind — Environment Variables
# Copy to .env and fill in values for local development.
# In Azure Container Apps these are injected automatically via Terraform.
# =============================================================================

# ---- Azure AI Foundry / OpenAI ------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ---- Document Intelligence ----------------------------------------------------
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# ---- AI Search (optional — only if enable_ai_search=true) ----------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=documind-index

# ---- Blob Storage --------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_RAW=raw-documents
AZURE_STORAGE_CONTAINER_PROCESSED=processed

# ---- Cosmos DB ------------------------------------------------------------------
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=documind
AZURE_COSMOS_CONTAINER=documents
COSMOS_SEARCH_CONTAINER=search_index

# ---- Key Vault ------------------------------------------------------------------
AZURE_KEYVAULT_URL=

# ---- Monitoring -----------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Embedding ------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- LLM Parameters ------------------------------------------------------------
LLM_TEMPERATURE=0.2

# ---- Pipeline / Chunker --------------------------------------------------------
CHUNKER_MAX_TOKENS=8000
CHUNKER_OVERLAP_TOKENS=200

# ---- Auth -----------------------------------------------------------------------
# AUTH_MODE=api_key
# API_KEY=
