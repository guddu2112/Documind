# =============================================================================
# DocuMind — Local / Offline Environment
# Copy to .env for a fully offline run backed by ChromaDB + SQLite + Ollama.
# =============================================================================

# ---- Backend selector ---------------------------------------------------------
BACKEND=local
AUTH_MODE=none

# ---- Ollama (LLM) -------------------------------------------------------------
# Requires: `ollama pull llama3.1:8b` (or the model of your choice)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_NUM_PREDICT=4096
LLM_TEMPERATURE=0.1

# ---- Embeddings (sentence-transformers, fully offline after first download) ---
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIM=384

# ---- ChromaDB (vector store) --------------------------------------------------
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=documind

# ---- SQLite (metadata / pipeline state) ---------------------------------------
SQLITE_PATH=./data/documind.sqlite

# ---- Local blob storage -------------------------------------------------------
LOCAL_BLOB_DIR=./data/blobs
AZURE_STORAGE_CONTAINER_RAW=raw-documents
AZURE_STORAGE_CONTAINER_PROCESSED=processed

# ---- Pipeline / Chunker -------------------------------------------------------
CHUNKER_MAX_TOKENS=8000
CHUNKER_OVERLAP_TOKENS=200

# ---- Telemetry ----------------------------------------------------------------
# Leave empty to disable App Insights export (uses in-memory tracer).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Azure fields (unused in local mode; leave blank) -------------------------
FOUNDRY_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_KEYVAULT_URL=
